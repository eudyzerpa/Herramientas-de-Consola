# Lee el log de acceso de Apache2 y filtra el número de descargas de una App, "archivo .apk"
cat access.log | grep GET | grep apk | grep 200 | wc -l


# Lee el log de acceso de Apache2 e imprime el total de visitas
awk '{print $1}' access.log| sort -u | wc -l


# Lee el log de acceso de Apache2 ordena e imprime el total de visitas
awk '{print $1 }' access.log | sort -u | uniq -c | sort -rn | wc -l


# Lee el log de acceso de Apache2 y lista las principales 10 IPs
cat access.log | grep apk | awk '{print $1 }'| sort -n | uniq -c | sort -rn | head  


# Lee el log de acceso de Apache2 y muestra las IPs de cada usuario que solicite la página índice ordenadas por el número de visitas:
awk -F'[ "]+' '$7 == "/" { ipcount[$1]++ } END { for (i in ipcount) { printf "%15s - %d\n", i, ipcount[i] } }' access.log


# Lee el log de acceso de Apache2 y muestra qué páginas fueron accedidas por un usuario desde una IP específica:
awk -F'[ "]+' '$1 == "1.2.3.4" { pagecount[$7]++ } END { for (i in pagecount) { printf "%15s - %d\n", i, pagecount[i] } }' access.log


# Lee el log de acceso de Apache2 y muestra la página más visitada de un sitio
awk '{split($11, arr, "//"); paginas[arr[2]]++} END {for (pagina in paginas) print paginas[pagina], pagina}' access.log | sort -rn | head -n 1


# Lee el log de acceso de Apache2 y muestra las 10 páginas más visitadas de un sitio
awk '{split($11, arr, "//"); paginas[arr[2]]++} END {for (pagina in paginas) print paginas[pagina], pagina}' access.log | sort -rn | head -n 10
